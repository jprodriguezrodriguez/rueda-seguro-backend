{
  "name": "proyecto-motos-login",
  "version": "1.0.0",
  "description": "Sistema de login con Node.js y SQLite para proyecto de motos",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "db:migrate": "node cli-db.js migrate",
    "db:create-migration": "node cli-db.js create-migration",
    "db:stats": "node cli-db.js stats",
    "db:reset": "node cli-db.js reset",
    "db:help": "node cli-db.js help",
    "test": "node test_api.js",
    "test:api": "powershell -File test_api_simple.ps1"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "keywords": [
    "nodejs",
    "sqlite",
    "login",
    "authentication",
    "jwt"
  ],
  "author": "Tu Nombre",
  "license": "MIT"
}
